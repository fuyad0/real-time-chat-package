{
    "name": "fuyad/chat",
    "description": "Laravel real-time chat package with Reverb WebSocket support, typing indicators, read receipts, and presence.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "chat",
        "reverb",
        "websocket",
        "real-time",
        "messenger",
        "inertia"
    ],
    "authors": [
        {
            "name": "Fuyad",
            "email": "mafuyad001@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "suggest": {
        "laravel/reverb": "WebSocket server for real-time chat broadcasting",
        "laravel/sanctum": "When using API routes for SPA authentication"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Fuyad\\Chat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fuyad\\Chat\\ChatServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
